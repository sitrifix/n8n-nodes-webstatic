{
  "name": "n8n-nodes-webstatic",
  "version": "0.2.0",
  "description": "n8n community node to serve static HTML pages via webhook URL, with optional password protection",
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "static",
    "html",
    "webpage",
    "hosting"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sitrifix/n8n-nodes-webstatic",
  "author": {
    "name": "sitrifix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sitrifix/n8n-nodes-webstatic.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier src --write",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WebStaticAuth.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WebStaticTrigger/WebStaticTrigger.node.js",
      "dist/nodes/WebStaticPage/WebStaticPage.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
